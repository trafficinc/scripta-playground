# Build output and release archives.
/target/
/dist/

# Keep Cargo.lock tracked for reproducible application builds.

# Python packaging and smoke-test caches.
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment files; sanitized examples can be committed.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc

# Local credentials and private keys.
.aws/
.ssh/
.netrc
credentials.json
credentials.*.json
secrets.json
secrets.*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Editor settings, logs, and OS metadata.
.idea/
.vscode/
*.swp
*.swo
*.log
.DS_Store
Thumbs.db
Desktop.ini
